{
  "name": "sgln-agent-functions",
  "description": "Serverless proxy that dispatches case-agent turns to Anthropic, OpenAI, or Gemini with server-side keys.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "test": "node --test evaluation.test.js",
    "test:emulator": "node scripts/test-emulator.js",
    "sync:cases": "node scripts/sync-case-packages.js",
    "predeploy": "npm run sync:cases && npm test",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.24.0"
  }
}
