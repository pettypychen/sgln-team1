# Local API keys for the Firebase Functions emulator.
# Copy this file to .secret.local (same directory) and fill in your keys.
# .secret.local is gitignored — never commit real keys.
#
# Only set the keys for providers you actually want to use locally.
# A request for a provider with no key returns 503.
#
# Usage:
#   cd functions && npm run serve        # starts emulator on port 5001
#   Set VITE_AGENT_ENDPOINT in app/frontend/.env (see .env.example)

ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
