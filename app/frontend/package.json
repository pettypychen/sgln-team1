{
  "name": "simworks-app",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:evaluation && npm run test:case-pack && npm run test:markdown && npm run test:ready-submission && npm run test:workspace-standardization && npm run test:local-fallback",
    "test:evaluation": "node --import tsx scripts/test-evaluation.ts",
    "test:case-pack": "node --import tsx scripts/test-case-pack.ts",
    "test:markdown": "node --import tsx scripts/test-markdown.tsx",
    "test:ready-submission": "node --import tsx scripts/test-ready-submission.tsx",
    "test:workspace-standardization": "node --import tsx scripts/test-workspace-standardization.tsx",
    "test:local-fallback": "node --import tsx scripts/verify-local-fallback.ts",
    "build": "npm run sync-version && tsc -b && vite build",
    "preview": "vite preview",
    "seed": "node --env-file=.env --import tsx scripts/seed-firestore.ts",
    "sync-version": "node --import tsx scripts/sync-version.ts",
    "version:patch": "npm version patch --no-git-tag-version && npm run sync-version",
    "version:minor": "npm version minor --no-git-tag-version && npm run sync-version",
    "version:major": "npm version major --no-git-tag-version && npm run sync-version"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
