{
  "name": "simworks-app",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:local-fallback": "tsx scripts/verify-local-fallback.ts",
    "build": "npm run sync-version && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "seed": "tsx --env-file=.env scripts/seed-firestore.ts",
    "sync-version": "tsx scripts/sync-version.ts",
    "version:patch": "npm version patch --no-git-tag-version && npm run sync-version",
    "version:minor": "npm version minor --no-git-tag-version && npm run sync-version",
    "version:major": "npm version major --no-git-tag-version && npm run sync-version"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.4"
  }
}
