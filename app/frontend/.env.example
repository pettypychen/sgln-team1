# Firebase configuration
# ---------------------------------------------------------------
# To get these values:
# 1. Go to https://console.firebase.google.com/project/sgln-team1-f8d61
# 2. Click the gear icon → Project settings
# 3. Scroll down to "Your apps" → select the web app
# 4. Copy the values from the "SDK setup and configuration" section
#
# Once filled in, save this file as .env in the same directory.
# The .env file is gitignored and must never be committed to GitHub.
# ---------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# AI case agent (optional)
# ---------------------------------------------------------------
# The case workspace calls a serverless proxy (Firebase Function `agentChat`)
# that holds the real LLM API keys server-side. See functions/README.md.
#
# Leave VITE_AGENT_ENDPOINT unset to run the workspace in demo mode with a
# built-in scripted agent (no keys, no backend needed).
#
# Local dev against the Functions emulator (uses your own keys, no Firebase access needed):
#   1. cd functions && cp .secret.local.example .secret.local  — fill in your key(s)
#   2. cd functions && npm run serve                            — starts emulator on port 5001
#   3. Set the two vars below and restart the Vite dev server
#
# VITE_AGENT_ENDPOINT=http://127.0.0.1:5001/sgln-team1-f8d61/us-central1/agentChat
# VITE_AGENT_PROVIDER=anthropic
#
# Production / staging (once the function is deployed to Firebase Hosting):
#   VITE_AGENT_ENDPOINT=/api/agent
#   VITE_AGENT_PROVIDER=anthropic
# ---------------------------------------------------------------

# VITE_AGENT_ENDPOINT=http://127.0.0.1:5001/sgln-team1-f8d61/us-central1/agentChat
# VITE_AGENT_PROVIDER=anthropic
