# Firebase configuration
# ---------------------------------------------------------------
# To get these values:
# 1. Go to https://console.firebase.google.com/project/sgln-team1-f8d61
# 2. Click the gear icon → Project settings
# 3. Scroll down to "Your apps" → select the web app
# 4. Copy the values from the "SDK setup and configuration" section
#
# Once filled in, save this file as .env in the same directory.
# The .env file is gitignored and must never be committed to GitHub.
# ---------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# AI case agent — model selection (optional)
# ---------------------------------------------------------------
# The chat panel shows a dropdown of AI models.
#
# LOCAL DEV — set one or more keys below. The Vite dev proxy injects them
# server-side; they never appear in browser network requests. Restart the dev
# server after changing these values.
#
# PRODUCTION — set VITE_AGENT_ENDPOINT. The frontend calls GET /api/agent at
# runtime to discover which providers have Firebase secrets configured. No
# VITE_*_API_KEY values are needed in production at all.
#
# NO KEYS — the dropdown shows "No AI model configured" and the workspace runs
# with a built-in scripted agent (no keys or backend needed).
# ---------------------------------------------------------------

# Anthropic Claude; get key at https://console.anthropic.com/settings/keys
# VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here
# VITE_ANTHROPIC_MODEL=claude-sonnet-5       # default: claude-sonnet-5

# OpenAI; get key at https://platform.openai.com/api-keys
# VITE_OPENAI_API_KEY=sk-your-key-here

# Google Gemini; get key at https://aistudio.google.com/app/apikey
# VITE_GOOGLE_API_KEY=your-key-here

# Z.ai — GLM models; get key at https://z.ai/manage-apikey/apikey-list
# VITE_ZAI_API_KEY=your-key-here
# VITE_ZAI_MODEL=glm-4.5-flash              # default: glm-4.5-flash; options: glm-4.5, glm-5.1, glm-5.2

# Alibaba Qwen; get key at https://home.qwencloud.com/apiKey
# VITE_ALIBABA_API_KEY=your-key-here
# VITE_ALIBABA_MODEL=qwen3.7-flash            # default: qwen3.7-flash; options: qwen3.7-plus, qwen3.7-max

# OpenRouter; get key at https://openrouter.ai/settings/keys
# VITE_OPENROUTER_API_KEY=your-key-here
# VITE_OPENROUTER_MODEL=deepseek/deepseek-r1  # default: deepseek/deepseek-r1; any slug from openrouter.ai/models works

# Production / staging (routes all models through the Firebase Function proxy)
# VITE_AGENT_ENDPOINT=/api/agent

# Evaluation and credentials service (optional)
# ---------------------------------------------------------------
# Leave unset for the seeded browser-local prototype repository.
# Set this to the Firebase Hosting rewrite for shared cross-device persistence.
#
# VITE_EVALUATION_API_ENDPOINT=/api/evaluation
#
# `VITE_DEMO_EVALUATOR_CODE` is local-demo-only. Production evaluator access
# is validated by the server-side EVALUATOR_ACCESS_CODE secret.
# VITE_DEMO_EVALUATOR_CODE=SIMWORKS-DEMO
