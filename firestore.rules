rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Released simulation content is public learner material. Evaluation,
    // participant, notification, credential, grant, session, and rate-limit
    // data is reachable only through trusted Firebase Functions.
    match /simulations/{simulationId} {
      allow read: if resource.data.released == true;
      allow write: if false;
    }

    // Participants write a record when they submit a case. Write-once — no
    // client-side reads, updates, or deletes. The evaluation pipeline reads
    // this collection through service-account credentials only.
    match /submissions/{submissionId} {
      allow create: if request.resource.data.keys().hasAll([
            'caseId', 'caseTitle', 'workProduct', 'evaluationStatus', 'submittedAt'
          ])
          && request.resource.data.evaluationStatus == 'pending_ai_processing'
          && request.resource.data.workProduct is string
          && request.resource.data.workProduct.size() > 0
          && request.resource.data.caseId is string;
      allow read: if true;
      allow update, delete: if false;
    }

    // Evaluation results created by the AI pipeline. Readable by evaluators;
    // all writes go through the Cloud Function service account.
    match /evaluations/{evaluationId} {
      allow read: if true;
      allow write: if false;
    }

    // Lightweight trigger documents created by the evaluator UI to manually
    // kick off AI evaluation for submissions that were never processed.
    // The Cloud Function deletes the document once evaluation completes.
    match /evaluationRetriggers/{submissionId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // AI call logs written exclusively by Cloud Functions.
    // Readable by the frontend admin dashboard (access is gated by the UI login).
    match /aiCallLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
